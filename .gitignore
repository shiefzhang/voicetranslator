.gradle/
**/build/
**/.cxx/
local.properties
.tools/
downloads/
# 只忽略**仓库根**的 third_party/（bootstrap.py 下载的 llama.cpp 源码）。
# ⚠️ 必须写前导斜杠：不带斜杠的 `third_party/` 匹配任意层级，会把
# native/nmt/third_party/ 一起吃掉 —— 那是**构建必需源码**，不是下载产物
# （app/src/main/cpp/CMakeLists.txt 直接引用其中的 ssentencepiece.cc 与
# onnxruntime 头），丢了以后 clone 下来 Android 编译直接失败。
/third_party/
model-work/
dist/
__pycache__/

# 本机测试用模型包（.vtmodel）。单个 0.2~1.6 GB，本地共 2.6 GB，
# 与安卓端一致：模型独立分发，不进仓库。
# 必须写前导斜杠锚定仓库根！不带斜杠的 `models/` 会匹配任意层级，
# 而 macOS 默认 core.ignorecase=true → 会连 ios/VoiceTranslator/Models/ 一起吃掉。
/models/

# --- iOS / Xcode ---
# 工程文件本身要提交（ios/VoiceTranslator.xcodeproj/project.pbxproj 由脚本生成），
# 但个人态与构建产物不提交。
xcuserdata/
*.xcuserstate
*.xcscmblueprint
*.moved-aside
DerivedData/
# 通配不带斜杠结尾，同时覆盖 ios/build/ 与 ios/build-device/。
# 注意：光写 ios/build/ 不够 —— 派生数据里除了 Build/ 还有
# Index.noindex/ ModuleCache.noindex/ SDKExplicitPrecompiledModules/ 等
# 数千个缓存文件（实测 3116 个、106 MB），它们不在 Build/ 之下。
ios/build*/
# 原生依赖产物（setup-ios-deps.sh 下载/编译到这里）
ios/third_party/

# 内置模型包（v0.2.10）：只有转写与专用翻译进 App，由
# `scripts/model-tiers.py --emit` 生成 —— 是**生成物**，不进仓库。
#   ① ios/BundledModels/                ~777 MB（解包后的只读目录）
#   ② app/src/main/assets/bundled-models/  ~800 MB（两个 .vtmodel）
# 「生成哪几类」写在 model-tiers.py 顶部的 BUNDLED 表里，通用翻译**不**内置。
# ⚠️ 必须写前导斜杠锚定仓库根 —— 不带斜杠的 `bundled-models/` 会匹配任意层级。
# 这里刻意**不**忽略 `models/`（源包）之外的东西：想确认内置产物是不是这一轮
# 生成的，就跑 `python3 scripts/model-tiers.py --verify`，别靠 git status。
/ios/BundledModels/
/app/src/main/assets/bundled-models/

.DS_Store

# --- WorkBuddy 本地目录 ---
# memory/ 是本地工作日志（含本机绝对路径），不进仓库。
# 若之后要把项目级技能共享给团队，改成忽略具体子目录、放行 skills/ 即可：
#   .workbuddy/*
#   !.workbuddy/skills/
.workbuddy/

